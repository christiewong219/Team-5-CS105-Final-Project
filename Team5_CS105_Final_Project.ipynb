        "# standardize the text and remove signs\n",
        "def clean(text):\n",
        "  text = text.lower()\n",
        "  text = re.sub(r'[^a-z0-9\\s]', '', text)\n",
        "  tokens = text.split()\n",
        "  return str(tokens)\n",
        "  #return\n",
        "\n",
        "df['text'] = df['text'].apply(clean)\n",
        "df.head()"
      ]
