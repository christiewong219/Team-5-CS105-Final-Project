        "\n",
        "sns.heatmap(cross_tab_sentiment, annot=True, fmt='d', cmap='Oranges')\n",
        "plt.title(\"Cross-tabulation of Sentiment vs Cluster\")\n",
        "plt.xlabel(\"Cluster\")\n",
        "plt.ylabel(\"Sentiment\")\n",
        "plt.text(1.5, 3.6, \"0: negative, 1: neutral, 2: positive\", fontsize=10, ha='center', va='bottom')\n",
        "plt.show()\n",
